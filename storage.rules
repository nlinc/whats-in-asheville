rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /households/{householdId}/{allPaths=**} {
      allow read, write: if householdId == 'asheville-condo' &&
        request.auth != null &&
        (request.auth.token.email == 'nlincoln28@gmail.com' || request.auth.token.email == 'cspritke@gmail.com');
    }
  }
}
